+  if (terminalQuit) return terminalQuit;
+  terminalQuit = (async () => {
+    await app.quit();
+    report("QUIT_TERMINAL_ACCEPTED");
+    await reportFlushed("QUIT_ACCEPTED");
+    socket.end();
+  })();
+  return terminalQuit;
+};
