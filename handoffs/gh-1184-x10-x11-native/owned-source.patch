+      report("COUNTERS", { effects });
+    } else {
+      throw new Error("unknown fixed fixture command");
+    }
+  } catch (error) {
+    report("FIXTURE_ERROR", { command: line, detail: String(error) });
+    throw error;
+  }
+}
