{
  // The fixture deliberately mixes exact and prefix scopes.
  "app": {
    "fs": {
      "read": [
        "/foo/exact",
        "/foo/bar/**",
        "$APPDATA/**",
        "https://example.com/a//b",
        "/foo/*literal*/bar"
      ],
      "write": []
    },
    // Permanent wildcard-swallow bypass fixture (KEL-208). Every entry but the
    // last strips to a prefix that is a scheme and separators and nothing else,
    // so it names no destination; the separator count differs because a URL
    // parser accepts all of these spellings for one host, while an authority
    // rule keyed on `://` only sees some of them. The last entry is the
    // legitimate origin-rooted grant they must not be confused with. A
    // URL-valued capability is not wired in v0 — `evaluate` is capability
    // agnostic, so this pins the matcher contract the moment one is.
    "net": {
      "connect": [
        "https://**",
        "https:/**",
        "https:///**",
        "wss://**",
        "a://**",
        "https:\\\\/**",
        "https:\\t//**",
        "https://api.example.com/**"
      ]
    },
    // A colon outside scheme position names a directory, not a URL: these are
    // ordinary path grants and must keep working (RFC 3986 3.1 anchors a
    // scheme at the start of the reference).
    "fs2": {
      "read": ["/srv/backup:/**", "\\\\?\\C:/**"]
    },
    // `C:` is a valid RFC 3986 scheme and the usual Windows drive; a drive
    // glob must keep plain path semantics rather than acquire an authority.
    "shell": {
      "open": ["C:/**"]
    }
  }
}
