{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "lib": ["ES2024"],
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitOverride": true,
    "strict": true,
    "target": "ES2024",
    "types": ["bun"]
  },
  "include": ["bench/**/*.ts", "src/**/*.ts"]
}
