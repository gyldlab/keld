#!/usr/bin/env bash
# Installed via just hooks-install into Git's common directory after review.
# Use Bun's formatter only: do not execute scripts from the checked-out revision.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: Bun is required for the JavaScript/TypeScript formatting gate." >&2
  exit 1
fi
bun fmt --no-script --check "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"
