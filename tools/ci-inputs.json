        "rust-toolchain.toml"
      ],
      "sha256": "fa5be918e1edc42e6542c6a8d35e3ea7c1f61ce5478659e0c5959cf4a0678be6"
    },
    "audit-readers": {
      "patterns": [
        "docs/audits/*.py",
        "justfile"
      ],
      "sha256": "c016f1d5be2503692771c7de7d6e4ab5b9024b2f07c479f8c08cfda201a3eb89"
    },
    "rustdoc-readers": {
      "patterns": [
