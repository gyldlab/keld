{
  "schema": "keld.ci-inputs/v1",
  "owner": "tools/ci_inputs.py (invoked only by tools/ci_changes.sh)",
  "known_inputs": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE*",
    "NOTICE*",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "rustfmt.toml",
    "deny.toml",
    "justfile",
    "llms.txt",
    "llms-full.txt",
    "crates/*",
    "packages/*",
    "docs/*",
    "tools/*",
    ".agents/*",
    ".github/*",
    ".codex/*",
    ".config/*",
    ".cargo/*",
    ".githooks/*",
    ".gitignore"
  ],
  "consumers": [
    {
      "owner": "Rust workspace external reads",
      "outputs": [
        "input_rust",
        "input_registry",
        "local_fmt-check",
        "local_clippy",
        "local_test"
      ],
      "inputs": [
        "packages/*",
        "tools/*.rs",
        "tools/*.ts",
        "llms-full.txt",
        "docs/onboarding/README.md",
        "docs/onboarding/04-wire-formats-and-contracts.md",
        "docs/architecture/01-overview.md",
        "docs/architecture/02-ipc.md",
        "docs/architecture/03-security.md",
        "docs/architecture/04-electron-compat.md",
        "docs/architecture/05-webview-and-native.md",
        "docs/architecture/06-runtime-and-tooling.md",
        "docs/architecture/07-agent-experience.md",
        "docs/engineering/product-status.md",
        "docs/engineering/decisions.md",
        "docs/engineering/keld-error-codes.md",
        "docs/engineering/budget-scoreboard.md",
        "docs/engineering/compat-scoreboard.md",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "rustfmt.toml",
        ".cargo/*",
        ".config/nextest.toml",
        "crates/*",
        "crates/keld-compat/fixtures/lifecycle-corpus/report.md"
      ],
      "contract": "Rust external reads include the CLI recursive tools registry scan, the generated docs_search corpus and its reviewed source inventory, security docs assertions, and crate-local reports. Reader-source drift invalidates this recorded scope. Agents still run full format, clippy and workspace tests before completion; ordinary invocation routing selects these gates only when relevant.",
      "reader_set": "rust-readers"
    },
    {
      "owner": "Bun package readers",
      "outputs": [
        "input_ts",
        "local_typescript"
      ],
      "inputs": [
        "crates/keld-ipc/tests/fixtures/*",
        "crates/keld-cli/templates/*",
        "crates/*.ts",
        "*receiver-semantics-v0.tsv",
        "crates/keld-ipc/src/lib.rs",
        "crates/keld-ipc/src/frame.rs",
        "crates/keld-ipc/src/echo.rs",
        "crates/keld-ipc/src/lifecycle.rs"
      ],
      "contract": "Bun reads IPC constants and CLI templates, echo declaration ownership scans every production .ts under crates and packages, and transport tests census every public-tree filename ending receiver-semantics-v0.tsv. Source-reader drift invalidates exclusions.",
      "reader_set": "bun-readers"
    },
    {
      "owner": "Unsafe and instruction inventory",
      "outputs": [
        "local_agents-md"
      ],
      "inputs": [
        "crates/*",
        "AGENTS.md",
        "*/AGENTS.md",
        ".agents/*"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Atomic protocol",
      "outputs": [
        "local_atomic-protocol"
      ],
      "inputs": [
        "AGENTS.md",
        ".agents/*",
        ".github/*",
        "docs/agents/*",
        "docs/onboarding/*",
        "CONTRIBUTING.md"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Instruction and workspace self-tests",
      "outputs": [
        "local_agent-context-test"
      ],
      "inputs": [
        ".codex/*",
        ".agents/*",
        "docs/agents/*"
      ],
      "contract": "The live agent-context and workspace checks remain unconditional because local task records are not Git diff inputs.",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Router self-tests",
      "outputs": [
        "local_ci-router-test"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "packages/*",
        ".github/*",
        ".config/*",
        ".cargo/*",
        "crates/*/Cargo.toml",
        "crates/keld-cli/tests/error_registry.rs",
        "crates/keld-cli/src/mcp/docs_search.rs",
        "crates/keld-cli/tests/doctor_mcp.rs",
        "crates/keld-cli/src/template.rs",
        "crates/keld-compat/tests/lifecycle_corpus.rs",
        "crates/keld-compat/tests/lifecycle_evidence_report.rs",
        "crates/keld-compat/tests/electron_lifecycle.rs",
        "crates/keld-runtime/src/unix_role_fixture.rs",
        "crates/keld-runtime/tests/windows_lpac_app_link.rs",
        "crates/keld-runtime/tests/windows_primary_generation.rs",
        "crates/keld-host/tests/no_flag/linux/support/project.rs",
        "crates/keld-host/tests/no_flag/windows/support/product.rs",
        "crates/keld-host/tests/no_flag/macos/support/product.rs",
        "crates/keld-host/tests/no_flag/macos/renderer_bridge.rs",
        "crates/keld-update/src/windows_extraction/tests.rs",
        "crates/keld-update/src/windows_baseline/tests/support.rs",
        "tools/llms_docs.rs"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Checkout hook contract",
      "outputs": [
        "local_hooks-test"
      ],
      "inputs": [
        "tools/hooks_test.sh"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Audit mutation suite",
      "outputs": [
        "local_audit-docs-test"
      ],
      "inputs": [
        "README.md",
        "docs/audits/*"
      ],
      "contract": "Copies README and the audit tree and reads historical publication anchors. Live verifier runs unconditionally for ancestry/history changes.",
      "reader_set": "audit-readers"
    },
    {
      "owner": "Placeholder scanner and self-tests",
      "outputs": [
        "local_doc-placeholders-test",
        "local_doc-placeholders-check"
      ],
      "inputs": [
        "docs/*",
        ".agents/*",
        "llms.txt",
        "llms-full.txt",
        "AGENTS.md",
        "README.md"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Product status and self-tests",
      "outputs": [
        "local_product-status-test",
        "local_product-status-check"
      ],
      "inputs": [],
      "contract": "Fixture self-tests consume the checker and its direct modules only. The separate live checker always validates Git evidence/ancestry and current consumers.",
      "reader_set": "status-test-readers"
    },
    {
      "owner": "Generated corpus",
      "outputs": [
        "local_llms-test",
        "local_llms-check"
      ],
      "inputs": [
        "docs/*",
        "llms.txt",
        "llms-full.txt"
      ],
      "contract": "tools/llms_docs.rs is in the bound reader set: widening SOURCES invalidates this consumer before any exclusion is reused.",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Repository hygiene",
      "outputs": [
        "local_hygiene"
      ],
      "inputs": [
        ".github/*",
        ".gitignore",
        ".config/*",
        ".codex/*",
        ".agents/*",
        "AGENTS.md",
        "*/AGENTS.md"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Rust documentation",
      "outputs": [
        "local_doc"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".cargo/*",
        "packages/*",
        "llms-full.txt",
        "tools/*",
        "crates/*"
      ],
      "contract": "Rust documentation compiles workspace sources including cross-tree include_str and include_bytes inputs.",
      "reader_set": "rustdoc-readers"
    },
    {
      "owner": "Dependency policy",
      "outputs": [
        "local_deny"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/*/Cargo.toml",
        "deny.toml",
        "rust-toolchain.toml",
        ".cargo/*"
      ],
      "contract": "",
      "reader_set": "dependency-command"
    },
    {
      "owner": "Mermaid local wrapper",
      "outputs": [
        "input_mermaid"
      ],
      "inputs": [
        "tools/mermaid*",
        "tools/markdown_contract.rs",
        "tools/repo_path_contract.rs",
        "tools/justfile_contract.rs",
        ".github/workflows/*"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    }
  ],
  "reader_sets": {
    "rust-readers": {
      "patterns": [
        "crates/keld-cli/tests/error_registry.rs",
        "crates/keld-cli/src/mcp/docs_search.rs",
        "crates/keld-cli/tests/doctor_mcp.rs",
        "crates/keld-cli/src/template.rs",
        "crates/keld-compat/tests/lifecycle_corpus.rs",
        "crates/keld-compat/tests/lifecycle_evidence_report.rs",
        "crates/keld-compat/tests/electron_lifecycle.rs",
        "crates/keld-runtime/src/unix_role_fixture.rs",
        "crates/keld-runtime/tests/windows_lpac_app_link.rs",
        "crates/keld-runtime/tests/windows_primary_generation.rs",
        "crates/keld-host/tests/no_flag/linux/support/project.rs",
        "crates/keld-host/tests/no_flag/windows/support/product.rs",
        "crates/keld-host/tests/no_flag/macos/support/product.rs",
        "crates/keld-host/tests/no_flag/macos/renderer_bridge.rs",
        "crates/keld-update/src/windows_extraction/tests.rs",
        "crates/keld-update/src/windows_baseline/tests/support.rs",
        "tools/llms_docs.rs"
      ],
      "sha256": "c26c933315a7a03c5be368bfba574ecbc02d346a2ee4e0f0b0954f635c7dd319"
    },
    "bun-readers": {
      "patterns": [
        "packages/*",
        "justfile"
      ],
      "sha256": "4ea89dd4d200f256ec5e4ad110194f97b982682d01b45b663fcdffacf4803476"
    },
    "policy-readers": {
      "patterns": [
        "justfile",
        "tools/*",
        "docs/audits/*.py",
        ".githooks/*",
        "rust-toolchain.toml"
      ],
      "sha256": "02224c774454556bbe630905454d45effdc9adc5c4df97ba79852d25f19cc101"
    },
    "audit-readers": {
      "patterns": [
        "docs/audits/*.py",
        "justfile"
      ],
      "sha256": "9bbb9f8a4c7c6a3cfcc9916dd5cab00a9a2031f6babd258a255b62fae1d9522e"
    },
    "rustdoc-readers": {
      "patterns": [
        "justfile",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".cargo/*"
      ],
      "sha256": "b139a374407d5f223cba4b4df1afd8916095112a10166fe781000a1dd4e2b3ba"
    },
    "dependency-command": {
      "patterns": [
        "justfile"
      ],
      "sha256": "ee59d4075ecdec3047821a274aab81be8af943801da29e31346aff6977db608d"
    },
    "status-test-readers": {
      "patterns": [
        "tools/product_status.rs",
        "tools/justfile_contract.rs",
        "tools/repo_path_contract.rs",
        "rust-toolchain.toml",
        "justfile"
      ],
      "sha256": "bc8a352e6bf9fa28c5dbd69eadaad7698d6af3c5f14c6122a5ade3e22ecefdde"
    }
  },
  "live_inputs": {
    "agent-context": "Ignored/local workspace task and resource records are read by tools/workspace.py check; malformed records can fail with identical tracked bytes.",
    "audit-docs": "Publication ancestry, historical report bytes and Git object availability are read by docs/audits/verify.py; missing/replaced history can fail with identical tracked bytes.",
    "product-status-check": "The ledger names evidence commits whose object availability and ancestry are validated; that live Git state is not represented by changed source paths.",
    "deny": "cargo deny check consumes the mutable advisory database as well as the lockfile; a new advisory can change its result with identical tracked bytes."
  },
  "rust_source_census": {
    "patterns": [
      "crates/*"
    ],
    "membership_sha256": "2faaa976594b09b24bfdce7e64c03c46af437c94af9d1dbb23eed154fec11916",
    "contract": "Broad census binds path membership only: new/removed crate paths fail closed. Existing crate-content edits select Rust through the crates/* input edge. A new cross-tree read in an existing source must register that reader and its input edge in the same change; exact-reader content digests then guard future drift."
  },
  "rust_package_inputs": {
    "keld-runtime": [
      "crates/keld-cli/templates/*",
      "packages/@keld/kipc/src/transport.ts"
    ],
    "keld-host": [
      "crates/keld-cli/templates/*",
      "packages/@keld/api/*",
      "packages/@keld/kipc/src/transport.ts"
    ],
    "keld-compat": [
      "packages/@keld/electron/*",
      "crates/keld-compat/fixtures/lifecycle-corpus/*"
    ],
    "keld-update": [
      "crates/keld-pack/tests/fixtures/windows-v0-content.tar"
    ]
  }
}
