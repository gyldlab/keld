    },
    "status-test-readers": {
      "patterns": [
        "tools/product_status.rs",
        "tools/justfile_contract.rs",
        "tools/repo_path_contract.rs",
        "rust-toolchain.toml",
        "justfile"
      ],
      "sha256": "38d6d871c4d78db7b66ef3044c6bda79285d42da0cfa2d3de43c304aa2f5716d"
    }
  },
  "live_inputs": {
    "agent-context": "Ignored/local workspace task and resource records are read by tools/workspace.py check; malformed records can fail with identical tracked bytes.",
    "audit-docs": "Publication ancestry, historical report bytes and Git object availability are read by docs/audits/verify.py; missing/replaced history can fail with identical tracked bytes.",
    "product-status-check": "The ledger names evidence commits whose object availability and ancestry are validated; that live Git state is not represented by changed source paths.",
    "deny": "cargo deny check consumes the mutable advisory database as well as the lockfile; a new advisory can change its result with identical tracked bytes."
  },
  "rust_source_census": {
    "patterns": [
      "crates/*"
    ],
    "membership_sha256": "e95306fa40f7902a3e8a588491b9d61deed75b463c389e60b431f1e46e2e4fab",
    "contract": "Broad census binds path membership only: new/removed crate paths fail closed. Existing crate-content edits select Rust through the crates/* input edge. A new cross-tree read in an existing source must register that reader and its input edge in the same change; exact-reader content digests then guard future drift."
  },
  "rust_package_inputs": {
    "keld-runtime": [
      "crates/keld-cli/templates/*",
      "packages/@keld/kipc/src/transport.ts"
    ],
    "keld-host": [
      "crates/keld-cli/templates/*",
      "packages/@keld/api/*",
      "packages/@keld/kipc/src/transport.ts"
    ],
    "keld-compat": [
      "packages/@keld/electron/*",
      "crates/keld-compat/fixtures/lifecycle-corpus/*"
    ],
    "keld-update": [
      "crates/keld-pack/tests/fixtures/windows-v0-content.tar"
    ],
    "keld-updater-helper": [
      "clippy.toml"
    ]
  },
  "rust_package_documentation_inputs": {
    "keld-update": [
      "docs/specs/kel53-full-package-activation.md"
    ]
  },
  "rust_package_documentation_contract": "Each listed document is read only as text by its package's own #[cfg(test)] code (keld-update: include_str! in src/records/tests.rs), so no reverse dependent compiles or reads it. A diff whose only matching paths are these documents selects that package without Cargo reverse dependents (#624); any other input of the same package keeps the expansion."
}
