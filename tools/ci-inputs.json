{
  "schema": "keld.ci-inputs/v1",
  "owner": "tools/ci_inputs.py (invoked only by tools/ci_changes.sh)",
  "known_inputs": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE*",
    "NOTICE*",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "rustfmt.toml",
    "deny.toml",
    "justfile",
    "llms.txt",
    "llms-full.txt",
    "crates/*",
    "packages/*",
    "docs/*",
    "tools/*",
    ".agents/*",
    ".github/*",
    ".codex/*",
    ".config/*",
    ".cargo/*",
    ".githooks/*",
    ".gitignore"
  ],
  "consumers": [
    {
      "owner": "Rust workspace external reads",
      "outputs": [
        "input_rust",
        "input_registry",
        "local_fmt-check",
        "local_clippy",
        "local_test"
      ],
      "inputs": [
        "packages/*",
        "tools/*.rs",
        "tools/*.ts",
        "llms-full.txt",
        "docs/onboarding/README.md",
        "docs/onboarding/04-wire-formats-and-contracts.md",
        "docs/architecture/01-overview.md",
        "docs/architecture/02-ipc.md",
        "docs/architecture/03-security.md",
        "docs/architecture/04-electron-compat.md",
        "docs/architecture/05-webview-and-native.md",
        "docs/architecture/06-runtime-and-tooling.md",
        "docs/architecture/07-agent-experience.md",
        "docs/engineering/product-status.md",
        "docs/engineering/decisions.md",
        "docs/engineering/keld-error-codes.md",
        "docs/engineering/budget-scoreboard.md",
        "docs/engineering/compat-scoreboard.md",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "rustfmt.toml",
        ".cargo/*",
        ".config/nextest.toml"
      ],
      "contract": "Rust external reads include the CLI recursive tools registry scan, the generated docs_search corpus and its reviewed source inventory, security docs assertions, and crate-local reports. Reader-source drift invalidates this recorded scope. Agents still run full format, clippy and workspace tests before completion; ordinary invocation routing selects these gates only when relevant.",
      "reader_set": "rust-readers"
    },
    {
      "owner": "Bun package readers",
      "outputs": [
        "input_ts",
        "local_typescript"
      ],
      "inputs": [
        "crates/keld-ipc/src/*",
        "crates/keld-ipc/tests/fixtures/*",
        "crates/keld-cli/templates/*",
        "crates/*.ts",
        "*receiver-semantics-v0.tsv"
      ],
      "contract": "Bun reads IPC constants and CLI templates, echo declaration ownership scans every production .ts under crates and packages, and transport tests census every public-tree filename ending receiver-semantics-v0.tsv. Source-reader drift invalidates exclusions.",
      "reader_set": "bun-readers"
    },
    {
      "owner": "Unsafe and instruction inventory",
      "outputs": [
        "local_agents-md"
      ],
      "inputs": [
        "crates/*",
        "AGENTS.md",
        "*/AGENTS.md",
        ".agents/*"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Atomic protocol",
      "outputs": [
        "local_atomic-protocol"
      ],
      "inputs": [
        "AGENTS.md",
        ".agents/*",
        ".github/*",
        "docs/agents/*",
        "docs/onboarding/*",
        "CONTRIBUTING.md"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Instruction and workspace self-tests",
      "outputs": [
        "local_agent-context-test"
      ],
      "inputs": [
        ".codex/*",
        ".agents/*",
        "docs/agents/*"
      ],
      "contract": "The live agent-context and workspace checks remain unconditional because local task records are not Git diff inputs.",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Router self-tests",
      "outputs": [
        "local_ci-router-test"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/*",
        "packages/*",
        ".github/*",
        ".config/*",
        ".cargo/*"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Checkout hook contract",
      "outputs": [
        "local_hooks-test"
      ],
      "inputs": [
        "tools/hooks_test.sh"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Audit mutation suite",
      "outputs": [
        "local_audit-docs-test"
      ],
      "inputs": [
        "README.md",
        "docs/audits/*"
      ],
      "contract": "Copies README and the audit tree and reads historical publication anchors. Live verifier runs unconditionally for ancestry/history changes.",
      "reader_set": "audit-readers"
    },
    {
      "owner": "Placeholder scanner and self-tests",
      "outputs": [
        "local_doc-placeholders-test",
        "local_doc-placeholders-check"
      ],
      "inputs": [
        "docs/*",
        ".agents/*",
        "llms.txt",
        "llms-full.txt",
        "AGENTS.md",
        "README.md"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Product status and self-tests",
      "outputs": [
        "local_product-status-test",
        "local_product-status-check"
      ],
      "inputs": [
        "*"
      ],
      "contract": "Checks dynamic evidence paths, Git history, Cargo/package membership and linked document consumers; no exclusion proof exists beyond an empty valid diff.",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Generated corpus",
      "outputs": [
        "local_llms-test",
        "local_llms-check"
      ],
      "inputs": [
        "docs/*",
        "llms.txt",
        "llms-full.txt"
      ],
      "contract": "tools/llms_docs.rs is in the bound reader set: widening SOURCES invalidates this consumer before any exclusion is reused.",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Repository hygiene",
      "outputs": [
        "local_hygiene"
      ],
      "inputs": [
        ".github/*",
        ".gitignore",
        ".config/*",
        ".codex/*",
        ".agents/*",
        "AGENTS.md",
        "*/AGENTS.md"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Rust documentation",
      "outputs": [
        "local_doc"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".cargo/*",
        "packages/*",
        "llms-full.txt",
        "tools/*"
      ],
      "contract": "Rust documentation compiles workspace sources including cross-tree include_str and include_bytes inputs.",
      "reader_set": "rustdoc-readers"
    },
    {
      "owner": "Dependency policy",
      "outputs": [
        "local_deny"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/*/Cargo.toml",
        "deny.toml",
        "rust-toolchain.toml",
        ".cargo/*"
      ],
      "contract": "",
      "reader_set": "dependency-command"
    },
    {
      "owner": "Mermaid local wrapper",
      "outputs": [
        "input_mermaid"
      ],
      "inputs": [
        "tools/mermaid*",
        "tools/markdown_contract.rs",
        "tools/repo_path_contract.rs",
        "tools/justfile_contract.rs",
        ".github/workflows/*"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    }
  ],
  "reader_sets": {
    "rust-readers": {
      "patterns": [
        "crates/*",
        "tools/llms_docs.rs",
        "Cargo.toml",
        "Cargo.lock",
        ".cargo/*"
      ],
      "sha256": "9ce55659ca28d5215d1eb9ddfdf4a8512949bf2944001fbfe2dde2d492670126"
    },
    "bun-readers": {
      "patterns": [
        "packages/*",
        "justfile"
      ],
      "sha256": "4ea89dd4d200f256ec5e4ad110194f97b982682d01b45b663fcdffacf4803476"
    },
    "policy-readers": {
      "patterns": [
        "justfile",
        "tools/*",
        "docs/audits/*.py",
        ".githooks/*",
        "rust-toolchain.toml"
      ],
      "sha256": "84807c18de038c226d20760075807f4044b987e0e4231d9d7039f5d3c247a6c9"
    },
    "audit-readers": {
      "patterns": [
        "docs/audits/*.py",
        "justfile"
      ],
      "sha256": "9bbb9f8a4c7c6a3cfcc9916dd5cab00a9a2031f6babd258a255b62fae1d9522e"
    },
    "rustdoc-readers": {
      "patterns": [
        "crates/*",
        "justfile",
        "Cargo.toml",
        "Cargo.lock",
        ".cargo/*"
      ],
      "sha256": "ac29f0732cd660a91fb093b96af0d0af5795a7172a37d29db5680992225a09ff"
    },
    "dependency-command": {
      "patterns": [
        "justfile"
      ],
      "sha256": "ee59d4075ecdec3047821a274aab81be8af943801da29e31346aff6977db608d"
    }
  },
  "live_inputs": {
    "agent-context": "Ignored/local workspace task and resource records are read by tools/workspace.py check; malformed records can fail with identical tracked bytes.",
    "audit-docs": "Publication ancestry, historical report bytes and Git object availability are read by docs/audits/verify.py; missing/replaced history can fail with identical tracked bytes.",
    "product-status-check": "The ledger names evidence commits whose object availability and ancestry are validated; that live Git state is not represented by changed source paths.",
    "deny": "cargo deny check consumes the mutable advisory database as well as the lockfile; a new advisory can change its result with identical tracked bytes."
  }
}
