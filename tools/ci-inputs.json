{
  "schema": "keld.ci-inputs/v1",
  "owner": "tools/ci_inputs.py (invoked only by tools/ci_changes.sh)",
  "known_inputs": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE*",
    "NOTICE*",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "rustfmt.toml",
    "deny.toml",
    "justfile",
    "llms.txt",
    "llms-full.txt",
    "crates/*",
    "packages/*",
    "docs/*",
    "tools/*",
    ".agents/*",
    ".github/*",
    ".codex/*",
    ".config/*",
    ".cargo/*",
    ".githooks/*",
    ".gitignore",
    ".gitleaks.toml",
    ".gitleaksignore"
  ],
  "consumers": [
    {
      "owner": "Rust workspace external reads",
      "outputs": [
        "input_rust",
        "input_registry",
        "local_fmt-check",
        "local_clippy",
        "local_test"
      ],
      "inputs": [
        "packages/*",
        "tools/*.rs",
        "tools/*.ts",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "rustfmt.toml",
        "clippy.toml",
        ".cargo/*",
        ".config/nextest.toml",
        "crates/*",
        "crates/keld-compat/fixtures/lifecycle-corpus/report.md",
        ".gitattributes"
      ],
      "documentation_inputs": [
        "llms-full.txt",
        "docs/onboarding/README.md",
        "docs/onboarding/04-wire-formats-and-contracts.md",
        "docs/architecture/01-overview.md",
        "docs/architecture/02-ipc.md",
        "docs/architecture/03-security.md",
        "docs/architecture/04-electron-compat.md",
        "docs/architecture/05-webview-and-native.md",
        "docs/architecture/06-runtime-and-tooling.md",
        "docs/architecture/07-agent-experience.md",
        "docs/engineering/product-status.md",
        "docs/engineering/decisions.md",
        "docs/engineering/keld-error-codes.md",
        "docs/engineering/budget-scoreboard.md",
        "docs/engineering/compat-scoreboard.md"
      ],
      "contract": "Rust external reads include the CLI recursive tools registry scan, the CLI GH-508 channel-id and capability-literal scan of every crate source tree, the generated docs_search corpus and its reviewed source inventory, security docs assertions, and crate-local reports. Reader-source drift invalidates this recorded scope. Agents still run full format, clippy and workspace tests before completion; ordinary invocation routing selects these gates only when relevant. documentation_inputs are read only as text by keld-cli: docs_search embeds llms-full.txt behind keld_cli::mcp, which no reverse dependent calls (keld-host tests use keld_cli::boot, create and dev only), and the registry and doctor tests are keld-cli's own. A diff whose only matching paths are documentation_inputs therefore selects keld-cli without Cargo reverse dependents (#624). A reverse dependent that starts reading one of these documents, or calling keld_cli::mcp, must move that document into inputs in the same change.",
      "reader_set": "rust-readers"
    },
    {
      "owner": "Bun package readers",
      "outputs": [
        "input_ts",
        "local_typescript"
      ],
      "inputs": [
        "crates/keld-ipc/tests/fixtures/*",
        "crates/keld-cli/templates/*",
        "crates/*.ts",
        "*receiver-semantics-v0.tsv",
        "crates/keld-ipc/src/lib.rs",
        "crates/keld-ipc/src/frame.rs",
        "crates/keld-ipc/src/echo.rs",
        "crates/keld-ipc/src/lifecycle.rs",
        "crates/keld-ipc/src/channel_table.rs",
        "crates/keld-wv/src/wkwebview/macos_bridge.rs"
      ],
      "contract": "Bun reads IPC constants and CLI templates, generates and drift-checks the channel-table region from crates/keld-ipc/src/channel_table.rs, scans production TypeScript and the macOS bridge's injected scripts for channel-id literals, echo declaration ownership scans every production .ts under crates and packages, and transport tests census every public-tree filename ending receiver-semantics-v0.tsv. Source-reader drift invalidates exclusions.",
      "reader_set": "bun-readers"
    },
    {
      "owner": "Unsafe and instruction inventory",
      "outputs": [
        "local_agents-md"
      ],
      "inputs": [
        "crates/*",
        "AGENTS.md",
        "*/AGENTS.md",
        ".agents/*"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Atomic protocol",
      "outputs": [
        "local_atomic-protocol"
      ],
      "inputs": [
        "AGENTS.md",
        ".agents/*",
        ".github/*",
        "docs/agents/*",
        "docs/onboarding/*",
        "CONTRIBUTING.md"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Instruction and workspace self-tests",
      "outputs": [
        "local_agent-context-test"
      ],
      "inputs": [
        ".codex/*",
        ".agents/*",
        "docs/agents/*"
      ],
      "contract": "The live agent-context and workspace checks remain unconditional because local task records are not Git diff inputs.",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Router self-tests",
      "outputs": [
        "local_ci-router-test"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "packages/*",
        ".github/*",
        ".config/*",
        ".cargo/*",
        "crates/*/Cargo.toml",
        "crates/keld-cli/tests/error_registry.rs",
        "crates/keld-cli/src/mcp/docs_search.rs",
        "crates/keld-cli/tests/doctor_mcp.rs",
        "crates/keld-cli/src/template.rs",
        "crates/keld-compat/tests/lifecycle_corpus.rs",
        "crates/keld-compat/tests/lifecycle_evidence_report.rs",
        "crates/keld-compat/tests/electron_lifecycle.rs",
        "crates/keld-core/src/app_session/tests/worker_link_e2e.rs",
        "crates/keld-compat/tests/support/corpus_manifest.rs",
        "crates/keld-compat/tests/support/corpus_admission.rs",
        "crates/keld-compat/tests/support/corpus_census.rs",
        "crates/keld-compat/tests/support/corpus_citation.rs",
        "crates/keld-ipc/tests/worker_link.rs",
        "crates/keld-runtime/src/unix_role_fixture.rs",
        "crates/keld-runtime/tests/windows_lpac_app_link.rs",
        "crates/keld-runtime/tests/windows_primary_generation.rs",
        "crates/keld-host/tests/no_flag/linux/support/project.rs",
        "crates/keld-host/tests/no_flag/windows/support/product.rs",
        "crates/keld-host/tests/no_flag/macos/support/product.rs",
        "crates/keld-host/tests/no_flag/macos/renderer_bridge.rs",
        "crates/keld-update/src/windows_extraction/tests.rs",
        "crates/keld-update/src/windows_baseline/tests/support.rs",
        "crates/keld-update/src/records/tests.rs",
        "crates/keld-updater-helper/tests/lint_config.rs",
        "crates/keld-cli/tests/channel_table_scan.rs",
        "crates/keld-cli/tests/support/rust_source_scan.rs",
        "tools/llms_docs.rs"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Checkout hook contract",
      "outputs": [
        "local_hooks-test"
      ],
      "inputs": [
        "tools/hooks_test.sh"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Audit mutation suite",
      "outputs": [
        "local_audit-docs-test"
      ],
      "inputs": [
        "README.md",
        "docs/audits/*"
      ],
      "contract": "Copies README and the audit tree and reads historical publication anchors. Live verifier runs unconditionally for ancestry/history changes.",
      "reader_set": "audit-readers"
    },
    {
      "owner": "Placeholder scanner and self-tests",
      "outputs": [
        "local_doc-placeholders-test",
        "local_doc-placeholders-check"
      ],
      "inputs": [
        "docs/*",
        ".agents/*",
        "llms.txt",
        "llms-full.txt",
        "AGENTS.md",
        "README.md"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Product status and self-tests",
      "outputs": [
        "local_product-status-test",
        "local_product-status-check"
      ],
      "inputs": [],
      "contract": "Fixture self-tests consume the checker and its direct modules only. The separate live checker always validates Git evidence/ancestry and current consumers.",
      "reader_set": "status-test-readers"
    },
    {
      "owner": "Generated corpus",
      "outputs": [
        "local_llms-test",
        "local_llms-check"
      ],
      "inputs": [
        "docs/*",
        "llms.txt",
        "llms-full.txt"
      ],
      "contract": "tools/llms_docs.rs is in the bound reader set: widening SOURCES invalidates this consumer before any exclusion is reused.",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Repository hygiene",
      "outputs": [
        "local_hygiene"
      ],
      "inputs": [
        ".github/*",
        ".gitignore",
        ".config/*",
        ".codex/*",
        ".agents/*",
        "AGENTS.md",
        "*/AGENTS.md",
        "crates/keld-ipc/channel_allocations.txt",
        "crates/keld-ipc/src/channel_table.rs"
      ],
      "contract": "ci-hygiene check also compares crates/keld-ipc/channel_allocations.txt with its merge base (GH-508 append-only rule); the baseline and channel_table.rs select it, as the hosted router does.",
      "reader_set": "policy-readers"
    },
    {
      "owner": "Rust documentation",
      "outputs": [
        "local_doc"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".cargo/*",
        "packages/*",
        "llms-full.txt",
        "tools/*",
        "crates/*"
      ],
      "contract": "Rust documentation compiles workspace sources including cross-tree include_str and include_bytes inputs.",
      "reader_set": "rustdoc-readers"
    },
    {
      "owner": "Dependency policy",
      "outputs": [
        "local_deny"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/*/Cargo.toml",
        "deny.toml",
        "crates/keld-updater-helper/deny.toml",
        "rust-toolchain.toml",
        ".cargo/*"
      ],
      "contract": "",
      "reader_set": "dependency-command"
    },
    {
      "owner": "Mermaid local wrapper",
      "outputs": [
        "input_mermaid"
      ],
      "inputs": [
        "tools/mermaid*",
        "tools/markdown_contract.rs",
        "tools/repo_path_contract.rs",
        "tools/justfile_contract.rs",
        ".github/workflows/*"
      ],
      "contract": "",
      "reader_set": "policy-readers"
    }
  ],
  "reader_sets": {
    "rust-readers": {
      "patterns": [
        "crates/keld-cli/tests/error_registry.rs",
        "crates/keld-cli/src/mcp/docs_search.rs",
        "crates/keld-cli/tests/doctor_mcp.rs",
        "crates/keld-cli/src/template.rs",
        "crates/keld-compat/tests/lifecycle_corpus.rs",
        "crates/keld-compat/tests/lifecycle_evidence_report.rs",
        "crates/keld-compat/tests/electron_lifecycle.rs",
        "crates/keld-core/src/app_session/tests/worker_link_e2e.rs",
        "crates/keld-compat/tests/support/corpus_manifest.rs",
        "crates/keld-compat/tests/support/corpus_admission.rs",
        "crates/keld-compat/tests/support/corpus_census.rs",
        "crates/keld-compat/tests/support/corpus_citation.rs",
        "crates/keld-ipc/tests/worker_link.rs",
        "crates/keld-runtime/src/unix_role_fixture.rs",
        "crates/keld-runtime/tests/windows_lpac_app_link.rs",
