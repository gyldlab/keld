{
  "description": "Keld session evidence gate; read-only, hash-bound handlers. Review via /hooks before use.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B -c \"import base64;exec(base64.b64decode(''))\"",
            "commandWindows": "python -I -B -c \"import base64;exec(base64.b64decode(''))\"",
            "timeout": 60,
            "statusMessage": "Checking session closeout evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B -c \"import base64;exec(base64.b64decode(''))\"",
            "commandWindows": "python -I -B -c \"import base64;exec(base64.b64decode(''))\"",
            "timeout": 60,
            "statusMessage": "Checking session closeout evidence"
          }
        ]
      }
    ]
  }
}
